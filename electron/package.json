{
  "name": "amazing-image-generator",
  "version": "1.1.0",
  "description": "Amazing image Generator (AiG) — local AI image generation",
  "main": "main.js",
  "author": "AiG",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "build": {
    "appId": "com.finetek.amazingimagegenerator",
    "productName": "Amazing image Generator",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../windows-app", "to": "backend", "filter": ["server.py", "static/**/*"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "extraResources": [
        { "from": "../runtime", "to": "python", "filter": ["**/*"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "Amazing image Generator",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns"
    }
  }
}
