<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Z-Image Generator"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="ZImageGen"
           UpgradeCode="F3A2B1C4-8D5E-4F6A-9B0C-1D2E3F4A5B6C">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Z-Image Generator — Local AI Image Generation" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Standard install-dir UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Directories -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ZImageGen" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="Z-Image Generator" />
      </Directory>
    </Directory>

    <!-- App files (harvested by heat into dist_components.wxs) -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppDirs" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <CreateFolder Directory="INSTALLFOLDER" />
        <CreateFolder Directory="models_placeholder" />
        <RegistryValue Root="HKLM"
                       Key="Software\ZImageGen"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <Shortcut Id="StartMenuLink"
                  Name="Z-Image Generator"
                  Description="Local AI Image Generator"
                  Target="[INSTALLFOLDER]start.bat"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ZImageGen"
                       Name="StartMenu"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C3D4E5F6-A7B8-9012-CDEF-012345678902">
        <Shortcut Id="DesktopLink"
                  Name="Z-Image Generator"
                  Description="Local AI Image Generator"
                  Target="[INSTALLFOLDER]start.bat"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\ZImageGen"
                       Name="Desktop"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Feature -->
    <Feature Id="MainFeature" Title="Z-Image Generator" Level="1">
      <ComponentGroupRef Id="DistComponents" />
      <ComponentRef Id="AppDirs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Launch after install -->
    <CustomAction Id="LaunchApp"
                  FileKey="StartBat"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
