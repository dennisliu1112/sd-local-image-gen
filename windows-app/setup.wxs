<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Z-Image Generator"
           Manufacturer="ZImageGen"
           Version="1.0.0.0"
           UpgradeCode="F3A2B1C4-8D5E-4F6A-9B0C-1D2E3F4A5B6C"
           Language="1033">

    <SummaryInformation Description="Local AI Image Generator" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ZImageGen" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="Z-Image Generator">
        <Component Id="StartMenuShortcut"
                   Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <Shortcut Id="StartMenuLink"
                    Name="Z-Image Generator"
                    Description="Local AI Image Generator"
                    Target="[INSTALLFOLDER]start.bat"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\ZImageGen"
                         Name="StartMenu"
                         Type="integer" Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="C3D4E5F6-A7B8-9012-CDEF-012345678902">
        <Shortcut Id="DesktopLink"
                  Name="Z-Image Generator"
                  Description="Local AI Image Generator"
                  Target="[INSTALLFOLDER]start.bat"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\ZImageGen"
                       Name="Desktop"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Z-Image Generator" Level="1">
      <ComponentGroupRef Id="DistComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>


</Wix>
